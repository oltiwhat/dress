{
  "name": "fustana",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-production-db.js && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:setup": "prisma db push && node scripts/seed-products.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.18.0",
    "@stripe/react-stripe-js": "^3.11.0",
    "@stripe/stripe-js": "^4.1.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^10.18.0",
    "jsonwebtoken": "^9.0.2",
    "next": "14.2.5",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.2",
    "sharp": "^0.33.4",
    "slugify": "^1.6.6",
    "stripe": "^16.2.0",
    "typescript": "^5.5.4",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.12",
    "@types/nodemailer": "^6.4.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.5.29",
    "prisma": "^5.18.0",
    "sass": "^1.77.8",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2"
  }
}
